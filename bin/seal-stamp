#!/usr/bin/env sh
# Prints the sealer's stamp, as `seal-stamp` instead of a long path into the
# plugin directory. Claude Code puts a plugin's bin/ on the Bash tool's PATH
# while the plugin is enabled, so a person can type it and see the drawing
# without a guarantee having been committed. With `--from`, it draws the
# values file the commit of a sealed guarantee queued, once, for a stamp no
# hook drew. It is not how a session ends a segment: the session that
# committed the sealed guarantee has the stamp drawn for it at the end of
# that turn.
#
# Resolves the script relative to this file, not the caller's cwd, so it works
# from any directory. Arguments pass straight through:
#   seal-stamp                    seal-stamp --shape
#   seal-stamp --from <file>      seal-stamp --shape --from <file>
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec python3 "$here/../hooks/launch.py" "$here/../skills/verify/scripts/seal_stamp.py" "$@"
