#!/usr/bin/env sh
# The plugin's one command, as `seal` instead of a long path into the plugin
# directory. Claude Code puts a plugin's bin/ on the Bash tool's PATH while the
# plugin is enabled, so a document can print a command a reader can actually
# type. Each tool is a subcommand, and `seal --help` lists them; a tool's
# subcommand hands every argument after its name to the tool's script, which
# `seal.py#TOOLS` names.
#
# Resolves the script relative to this file, not the caller's cwd, so it works
# from any directory. Arguments pass straight through:
#   seal export                   seal export --check
#   seal export --output ~/keys   seal import seal-repo-2026-09-03.zip
#   seal mode                     seal mode --check
#   seal mode local               seal mode shared
#   seal pr-checks                seal pr-checks install
#   seal pr-checks remove         seal no-work-item
#   seal gate --base origin/main --record seal/threads/<work-item-id>
#   seal fold --ceiling 1000      seal rules --check
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec python3 "$here/../hooks/launch.py" "$here/../skills/implement/scripts/seal.py" "$@"
