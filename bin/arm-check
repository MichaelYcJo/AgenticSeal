#!/usr/bin/env sh
# Runs the arm enumeration as `arm-check` instead of a long path into the
# plugin directory. Claude Code puts a plugin's bin/ on the Bash tool's PATH
# while the plugin is enabled, so a session can type the command #262 asks for.
#
# Resolves the script relative to this file, not the caller's cwd, so it works
# from any directory. Arguments pass straight through:
#   arm-check hooks/implementer-notice.py
#   arm-check hooks/implementer-notice.py --tests "bin/test tests/test_implementer_notice.py -q"
#   arm-check hooks/implementer-notice.py --only main --tests "..."
#
# With no --tests it lists the arms and mutates nothing. With --tests it
# runs that command once against the module as it is, and refuses the run
# with exit 2 unless it passes there -- nothing written, no arm measured,
# and anything the command itself changed in the module put back, or, where
# it cannot be, the reason said.
# Then it mutates each arm in turn, runs the command, and reports the arms
# nothing kills -- restoring the module from held bytes and comparing the
# hash after every one. A measured run is report-only: exit 0 whether or not
# an arm survived.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec python3 "$here/../hooks/launch.py" "$here/../skills/verify/scripts/arm_check.py" "$@"
