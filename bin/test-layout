#!/usr/bin/env sh
# Runs skills/verify/scripts/test_layout.py as `test-layout`: whether each test
# file stands where the test layout puts it (#942). Claude Code puts a plugin's
# bin/ on the Bash tool's PATH while the plugin is enabled.
#
# Resolves the script relative to this file, not the caller's cwd, so it works
# from any directory. Arguments pass straight through:
#   test-layout --check            refuse a file that breaks the layout
#   test-layout --check --all      refuse a file that declares no TARGET too
#   test-layout --pairs tests/x.py name two cases of a class that look alike
#   test-layout --moved BASE --from OLD... NEW
#                                  whether NEW holds OLD's cases at BASE,
#                                  only moved, so its module needs no mutants
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec python3 "$here/../hooks/launch.py" "$here/../skills/verify/scripts/test_layout.py" "$@"
