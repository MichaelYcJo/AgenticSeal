#!/usr/bin/env sh
# The plugin's one command, as `agentic` instead of a long path into the plugin
# directory. Claude Code puts a plugin's bin/ on the Bash tool's PATH while the
# plugin is enabled, so a document can print a command a reader can actually
# type. Each tool is a subcommand, and `agentic --help` lists them; a tool's
# subcommand hands every argument after its name to the tool's script, which
# `agentic.py#TOOLS` names.
#
# Resolves the script relative to this file, not the caller's cwd, so it works
# from any directory. Arguments pass straight through:
#   agentic export                   agentic export --check
#   agentic export --output ~/keys   agentic import agentory-repo-2026-09-03.zip
#   agentic mode                     agentic mode --check
#   agentic mode local               agentic mode shared
#   agentic pr-checks                agentic pr-checks install
#   agentic pr-checks remove
#   agentic gate --base origin/main --record agentory/threads/<work-item-id>
#   agentic fold --ceiling 1000      agentic rules --check
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec python3 "$here/../lib/launch.py" "$here/../skills/implement/scripts/agentic.py" "$@"
